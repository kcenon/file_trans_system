+auto quic_socket::abort() -> void
+{
+	is_receiving_.store(false);
+	handshake_complete_.store(false);
+	state_.store(quic_connection_state::closed);
+	std::error_code ignored;
+	udp_socket_.cancel(ignored);
+	udp_socket_.close(ignored);
+	retransmit_timer_.cancel();
+	idle_timer_.cancel();
+	std::lock_guard<std::mutex> lock(callback_mutex_);
+	stream_data_cb_ = {}; connected_cb_ = {}; error_cb_ = {}; close_cb_ = {};
+}
